# ---------------------------------------------------------------------------
# DeepStatArb — environment template
#
# USAGE:  copy to `.env` and fill in.  `.env` is gitignored; this file is not.
#         Never put a real secret in this file.
#
# STATUS AS OF DAY 1: the project needs NO credentials yet. yfinance and the
# NSE public endpoints are unauthenticated. This file exists so that if a paid
# or keyed source is introduced later, there is exactly one place it goes.
# ---------------------------------------------------------------------------

# Overrides the auto-detected project root (normally leave unset).
# DSA_PROJECT_ROOT=

# Overrides config/ directory (normally leave unset).
# DSA_CONFIG_DIR=

# Log level for console output: DEBUG | INFO | WARNING | ERROR
DSA_LOG_LEVEL=INFO

# --- Optional future data sources (NOT required as of Day 1) ---------------
# Alpha Vantage — free tier, 25 req/day. Only if yfinance proves unreliable.
# ALPHAVANTAGE_API_KEY=

# Kite Connect (Zerodha) — PAID, ~Rs.2000/month. Only if we need true
# point-in-time F&O constituent history. Discuss before adopting.
# KITE_API_KEY=
# KITE_API_SECRET=
