# ---------------------------------------------------------------------------
# DeepStatArb .gitignore
# Rule of thumb: anything that can be regenerated by `make` is ignored.
# Anything a reviewer needs to reproduce the result is tracked.
# ---------------------------------------------------------------------------

# --- Secrets. Never relax these. -------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
secrets.yaml
config/*.local.yaml

# --- Data: large, regenerable, and possibly vendor-licensed ----------------
data/**
!data/**/.gitkeep
*.parquet
*.feather
*.h5
*.hdf5

# --- Trained model artefacts ------------------------------------------------
models/**
!models/.gitkeep
*.pt
*.pth
*.joblib
*.pkl
*.ubj

# --- Logs and run output ----------------------------------------------------
logs/**
!logs/.gitkeep
*.log

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
env/
.python-version

# --- Tooling ----------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# NOTE: figures/ and reports/ are intentionally TRACKED. The README embeds the
# survival curve, and a reviewer must be able to see the headline figure
# without running the pipeline. They are regenerated by `make`, never by hand.
